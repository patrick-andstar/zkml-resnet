+    if any(v < 0 for v in paddings):
+      raise RuntimeError('PADV2(op%d) paddings 含负值 %r（负填充=裁剪，未覆盖）'
+                         % (op_idx, paddings))
+    if paddings[0] or paddings[1] or paddings[6] or paddings[7]:
+      raise RuntimeError('PADV2(op%d) 在 batch/channel 轴上有填充 %r，未覆盖'
+                         % (op_idx, paddings))
